# ==============================================================================
# Frontend — environment configuration TEMPLATE
# ==============================================================================
# Copy this file to `frontend/.env` and adjust the values:
#
#       cp frontend/.env.example frontend/.env
#
# `frontend/.env` is the file Docker Compose actually loads (via `env_file:`),
# and it is also the file Vite loads automatically for a local `npm run dev`.
#
# After editing, recreate the container:
#       docker compose up -d --force-recreate frontend
# ==============================================================================

# Base URL of the backend API, as reachable from the browser.
# Must be reachable from the BROWSER, not from inside the Docker network —
# so use http://localhost:8080, not http://backend:8080.
VITE_API_BASE_URL=http://localhost:8080
