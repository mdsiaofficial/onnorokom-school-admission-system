# ==============================================================================
# Backend API — environment configuration TEMPLATE
# ==============================================================================
# Copy this file to `backend/.env` and adjust the values:
#
#       cp backend/.env.example backend/.env
#
# `backend/.env` is the file Docker Compose actually loads (via `env_file:`),
# and it is also the file you `source` for a local run without Docker:
#
#       set -a; source backend/.env; set +a; dotnet run --project backend
#
# After editing, recreate the container (Compose reads the file at `up` time):
#       docker compose up -d --force-recreate backend
#
# NOTE: only local-development placeholders belong here — never real credentials.
# ==============================================================================

# --- ASP.NET Core -------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# --- PostgreSQL (used by the `db` service to initialize the cluster) -----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=school_admission

# --- Database connection used by the API --------------------------------------
# Inside Docker the host is the Compose service name `db`.
# Running the API directly on the host? Use Host=localhost instead.
# Keep the credentials in sync with POSTGRES_USER / POSTGRES_PASSWORD above.
#
# Changing POSTGRES_PASSWORD after the database volume has been initialized has
# no effect on the existing cluster — recreate the volume to re-apply it:
#       docker compose down -v && docker compose up -d
ConnectionStrings__Default=Host=db;Port=5432;Database=school_admission;Username=postgres;Password=postgres;Include Error Detail=true;

# --- Application settings -----------------------------------------------------
# Seat hold lifetime in seconds (must be a positive integer; the API refuses to
# start otherwise). 600 = 10 minutes.
HOLD_DURATION_SECONDS=600

# How often the background sweeper marks expired holds as EXPIRED (seconds).
EXPIRY_SWEEP_INTERVAL_SECONDS=5

# Seed 12 demo classes when the database is empty.
SEED_DEMO_DATA=true

# Browser origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000
